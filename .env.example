# Create a Postgres database on Vercel: https://vercel.com/postgres
POSTGRES_URL=
POSTGRES_PRISMA_URL=
POSTGRES_URL_NON_POOLING=

# Generate one here: https://generate-secret.vercel.app/32 (only required for localhost)
AUTH_SECRET=

# Optional: a Mockatoo test account for the full sign-in test (pnpm test:e2e).
# Sign up free at https://app.mockatoo.globalunderdog.com
MOCKATOO_TEST_EMAIL=
MOCKATOO_TEST_PASSWORD=
